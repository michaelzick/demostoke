{
  "name": "demostoke",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --port 8080",
    "build": "next build",
    "start": "next start --port 8080",
    "lint": "eslint .",
    "test": "npm run lint",
    "test:unit": "vitest run",
    "type-check": "next typegen && tsc --noEmit",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev --config wrangler.jsonc --infer-origin-from-routes=false --env-file .env.next",
    "deploy:preview": "DEMOSTOKE_DEPLOYMENT_TARGET=preview npm run build:cloudflare && wrangler preview --config wrangler.jsonc",
    "deploy:cloudflare": "DEMOSTOKE_DEPLOYMENT_TARGET=production npm run build:cloudflare && wrangler deploy --config wrangler.jsonc"
  },
