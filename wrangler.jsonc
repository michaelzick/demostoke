{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demostoke",
  "account_id": "0c4a1637a60ec527675c7e248b73e39d",
  "main": "dist/worker/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/sitemap.xml"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "no_bundle": true,
  "routes": [
    {
      "pattern": "demostoke.com",
      "custom_domain": true
    },
    {
      "pattern": "www.demostoke.com",
      "custom_domain": true
    }
  ],
  "previews": {
    "vars": {
      "NODE_ENV": "production"
    }
  }
}
