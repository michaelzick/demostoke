{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "demostoke",
  "account_id": "0c4a1637a60ec527675c7e248b73e39d",
  "main": "server/next-worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "pattern": "demostoke.com",
      "custom_domain": true
    },
    {
      "pattern": "www.demostoke.com",
      "custom_domain": true
    }
  ],
  "previews": {
    "vars": {
      "NODE_ENV": "production"
    }
  }
}
