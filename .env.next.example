# Use the public URL and publishable key for a local Supabase instance.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_key

# local enables interactive flows for local fixtures.
DEMOSTOKE_DEPLOYMENT_TARGET=local

# Optional, for a configured public external shop feed.
NEXT_PUBLIC_USE_SHOP_GEAR_FEED=false
SHOP_GEAR_FEED_URL=
SHOP_GEAR_FEED_SHOP_SLUG=
SHOP_GEAR_FEED_API_KEY=
